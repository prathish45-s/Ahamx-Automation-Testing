{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "skipLibCheck": true
  },
  "include": ["src/**/*", "tests/**/*", "global-setup.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "playwright-report"]
}
